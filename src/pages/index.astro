---
import Footer from '../components/Footer.astro';
import NavBar from '../components/NavBar.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { highlights, interests, links, projects } from '../data/site';
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<NavBar />
	<main id="main-content">
		<section id="home" class="introduction">
			<h1>Caden Page</h1>
			<p>First-year Mechanical Engineering PhD student at UT Austin.<br />NSF Graduate Research Fellow.</p>
			<p>
				I conduct research in the
				<a href="https://robin-lab.cs.utexas.edu/">RobIn (Robot Interactive Intelligence) Lab</a>.
			</p>
			<p>
				My research focuses on robot learning and world models for control.
			</p>
			<p>
				I have worked on surgical robotics research in HERO Lab and served as
				Digital Fabrication Lead at Texas Invention Works.
			</p>
			<p class="profile-links">
				<a href={links.email}>Email</a>
				<a href={links.github} target="_blank" rel="noreferrer">GitHub</a>
				<a href={links.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
			</p>
		</section>

		<section id="research">
			<h2>Research interests</h2>
			<ul>{interests.map((interest) => <li>{interest}</li>)}</ul>
		</section>

		<section id="projects">
			<h2>Projects</h2>
			<div class="project-list">
				{projects.map((project) => <ProjectCard {...project} />)}
			</div>
		</section>

		<section id="experience">
			<h2>Experience and education</h2>
			<ul>{highlights.map((highlight) => <li>{highlight}</li>)}</ul>
		</section>

		<section id="cv">
			<h2>CV</h2>
			<p>CV not yet uploaded.</p>
		</section>

		<section id="contact">
			<h2>Contact</h2>
			<p><a href={links.email}>caden@cadenpage.com</a></p>
		</section>
	</main>
	<Footer />
</Layout>

<style>
	.introduction { padding-top: 0; }
	h1 { margin-bottom: 0.8rem; }
	.profile-links { display: flex; flex-wrap: wrap; gap: 1.1rem; }
</style>
