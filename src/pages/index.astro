---
import Footer from '../components/Footer.astro';
import LinkButton from '../components/LinkButton.astro';
import NavBar from '../components/NavBar.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { highlights, interests, links, projects } from '../data/site';
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<NavBar />

	<main>
		<section class="hero" id="home">
			<div class="container hero-grid">
				<div class="hero-content">
					<p class="kicker">Robotics Research &middot; Mechanical Engineering</p>
					<h1>
						Caden Page
						<span>Incoming robotics PhD student and NSF Graduate Research Fellow.</span>
					</h1>
					<p class="hero-statement">
						I build robot learning, perception, and control systems for embodied autonomy,
						with interests in surgical robotics and reliable interaction in the physical world.
					</p>
					<div class="hero-actions" id="cv">
						<LinkButton href="#projects" label="View projects" variant="primary" />
						<LinkButton href={links.cv} label="CV / Resume placeholder" />
					</div>
					<div class="profile-links" aria-label="Professional links">
						<a href={links.github} target="_blank" rel="noreferrer">GitHub</a>
						<a href={links.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
						<a href={links.email}>Email</a>
					</div>
				</div>

				<aside class="focus-panel" aria-label="Research profile summary">
					<p class="panel-label">Current focus</p>
					<div class="system-diagram" aria-hidden="true">
						<div>Perception</div>
						<span>→</span>
						<div>Learning</div>
						<span>→</span>
						<div>Control</div>
					</div>
					<p>
						Engineering intelligent robotic systems that connect sensing, learned policies,
						and physically grounded control.
					</p>
					<dl>
						<div>
							<dt>Institution</dt>
							<dd>UT Austin</dd>
						</div>
						<div>
							<dt>Research direction</dt>
							<dd>Embodied autonomy</dd>
						</div>
					</dl>
				</aside>
			</div>
		</section>

		<section class="section projects-section" id="projects">
			<div class="container">
				<SectionHeading
					eyebrow="Featured projects"
					title="Technical systems and research-driven builds"
					description="Projects are the core of this portfolio: hardware, perception, learning, and robotics software developed toward capable embodied systems."
				/>
				<div class="projects-grid">
					{projects.map((project) => <ProjectCard {...project} />)}
				</div>
			</div>
		</section>

		<section class="section research-section" id="research">
			<div class="container research-grid">
				<SectionHeading
					eyebrow="Research interests"
					title="Robotics in complex physical environments"
					description="I am interested in methods that make robots more capable, data-efficient, and trustworthy when sensing and acting in the real world."
				/>
				<ul class="interest-list">
					{interests.map((interest, index) => (
						<li>
							<span>{String(index + 1).padStart(2, '0')}</span>
							{interest}
						</li>
					))}
				</ul>
			</div>
		</section>

		<section class="section experience-section" id="experience">
			<div class="container highlights-grid">
				<div>
					<SectionHeading
						eyebrow="Selected highlights"
						title="Research, education, and technical leadership"
						description="A concise record of the experiences supporting my developing research direction."
					/>
				</div>
				<ul class="highlight-list">
					{highlights.map((highlight) => <li>{highlight}</li>)}
				</ul>
			</div>
		</section>

		<section class="section about-section" id="contact">
			<div class="container about-card">
				<div>
					<p class="kicker">About</p>
					<h2>Mechanical engineering grounded in robotics research.</h2>
				</div>
				<div class="about-copy">
					<p>
						I am a mechanical engineering student at The University of Texas at Austin and an
						incoming Mechanical Engineering PhD student at UT Austin. My work is motivated by
						robots that can perceive, learn, and act robustly in demanding environments.
					</p>
					<p>
						My experience spans surgical robotics research in HERO Lab and hands-on engineering
						leadership as a former Digital Fabrication Lead at Texas Invention Works.
					</p>
					<div class="contact-actions">
						<LinkButton href={links.email} label="Email" variant="primary" />
						<LinkButton href={links.github} label="GitHub" external={true} />
						<LinkButton href={links.linkedin} label="LinkedIn" external={true} />
					</div>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Layout>

<style>
	.hero {
		padding: clamp(4.5rem, 8vw, 6.75rem) 0 4.75rem;
	}

	.hero-grid {
		align-items: start;
		display: grid;
		gap: 3.25rem;
		grid-template-columns: minmax(0, 1.55fr) minmax(300px, 0.85fr);
	}

	.hero-content {
		max-width: 700px;
	}

	.kicker {
		color: var(--color-ut);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		line-height: 1;
		margin-bottom: 1.25rem;
		text-transform: uppercase;
	}

	h1 {
		font-size: clamp(3.2rem, 7vw, 5.2rem);
		line-height: 0.97;
		margin-bottom: 1.55rem;
	}

	h1 span {
		color: #304c5d;
		display: block;
		font-size: clamp(1.65rem, 3.6vw, 2.55rem);
		font-weight: 550;
		line-height: 1.18;
		margin-top: 1.15rem;
		max-width: 680px;
	}

	.hero-statement {
		font-size: 1.1rem;
		max-width: 620px;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
		margin-top: 2.2rem;
	}

	.profile-links {
		display: flex;
		gap: 1.5rem;
		margin-top: 2rem;
	}

	.profile-links a {
		color: var(--color-muted);
		font-size: 0.92rem;
		font-weight: 550;
		text-decoration: underline;
		text-decoration-color: #bbc9ce;
		text-underline-offset: 0.35rem;
	}

	.profile-links a:hover {
		color: var(--color-accent);
	}

	.focus-panel {
		background: var(--color-surface);
		border: 1px solid var(--color-line);
		border-radius: var(--radius);
		box-shadow: var(--shadow-soft);
		padding: 1.45rem;
	}

	.panel-label {
		color: var(--color-accent);
		font-size: 0.74rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.system-diagram {
		align-items: center;
		background: #edf4f8;
		border: 1px solid #d3e1e8;
		border-radius: 9px;
		display: flex;
		gap: 0.45rem;
		justify-content: center;
		margin: 1.25rem 0;
		padding: 1.55rem 0.55rem;
	}

	.system-diagram div {
		background: var(--color-surface);
		border: 1px solid #c1d4df;
		border-radius: 5px;
		color: var(--color-ink);
		font-size: 0.7rem;
		font-weight: 600;
		padding: 0.45rem 0.36rem;
	}

	.system-diagram span {
		color: var(--color-accent);
	}

	dl {
		border-top: 1px solid var(--color-line);
		display: grid;
		gap: 1rem;
		margin: 1.3rem 0 0;
		padding-top: 1.1rem;
	}

	dt {
		color: var(--color-muted);
		font-size: 0.77rem;
		margin-bottom: 0.3rem;
	}

	dd {
		font-size: 0.93rem;
		font-weight: 600;
		margin: 0;
	}

	.projects-section {
		background: rgba(255, 255, 255, 0.46);
		border-bottom: 1px solid var(--color-line);
		border-top: 1px solid var(--color-line);
	}

	.projects-grid {
		display: grid;
		gap: 1.35rem;
		grid-template-columns: repeat(4, minmax(0, 1fr));
	}

	.research-grid {
		align-items: start;
		display: grid;
		gap: 3.5rem;
		grid-template-columns: 1fr 1fr;
	}

	.interest-list {
		background: var(--color-surface);
		border: 1px solid var(--color-line);
		border-radius: var(--radius);
		list-style: none;
		margin: 0;
		padding: 0 1.45rem;
	}

	.interest-list li {
		align-items: center;
		border-bottom: 1px solid var(--color-line);
		color: var(--color-ink);
		display: flex;
		font-size: 1rem;
		font-weight: 550;
		gap: 1.25rem;
		padding: 1.05rem 0;
	}

	.interest-list li:last-child {
		border-bottom: 0;
	}

	.interest-list span {
		color: var(--color-accent);
		font-size: 0.76rem;
		font-weight: 700;
	}

	.experience-section {
		background-color: var(--color-surface);
		border-bottom: 1px solid var(--color-line);
		border-top: 1px solid var(--color-line);
	}

	.highlights-grid {
		display: grid;
		gap: 3.25rem;
		grid-template-columns: 1fr 1.05fr;
	}

	.highlight-list {
		display: grid;
		gap: 0;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.highlight-list li {
		border-bottom: 1px solid var(--color-line);
		color: #324651;
		font-size: 0.97rem;
		line-height: 1.5;
		padding: 0.92rem 0 0.92rem 1.1rem;
		position: relative;
	}

	.highlight-list li::before {
		background: var(--color-ut);
		border-radius: 50%;
		content: '';
		height: 5px;
		left: 0;
		position: absolute;
		top: 1.47rem;
		width: 5px;
	}

	.about-card {
		background: #183447;
		border-top: 3px solid var(--color-ut);
		border-radius: var(--radius);
		color: #ffffff;
		display: grid;
		gap: 3.2rem;
		grid-template-columns: 0.88fr 1.12fr;
		padding: clamp(1.8rem, 5vw, 3.2rem);
	}

	.about-card .kicker {
		color: #f0ac72;
	}

	.about-card h2 {
		color: #ffffff;
		font-size: clamp(1.65rem, 3vw, 2.25rem);
		line-height: 1.25;
	}

	.about-copy {
		display: grid;
		gap: 1rem;
	}

	.about-copy p {
		color: #ced9de;
	}

	.contact-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		margin-top: 0.7rem;
	}

	@media (max-width: 1000px) {
		.projects-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 840px) {
		.hero-grid,
		.research-grid,
		.highlights-grid,
		.about-card {
			grid-template-columns: 1fr;
		}

		.focus-panel {
			max-width: 460px;
		}
	}

	@media (max-width: 590px) {
		.hero {
			padding-top: 3.5rem;
		}

		.projects-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
