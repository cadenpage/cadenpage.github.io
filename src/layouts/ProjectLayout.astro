---
import Footer from '../components/Footer.astro';
import NavBar from '../components/NavBar.astro';
import Layout from './Layout.astro';

const { frontmatter } = Astro.props;
const { title, summary, tags = [] } = frontmatter;
---

<Layout title={`${title} | Caden Page`} description={summary}>
	<NavBar />
	<main class="project-page">
		<div class="container">
			<a class="back-link" href="/#projects">← Back to featured projects</a>
			<header>
				<p class="label">Project page placeholder</p>
				<h1>{title}</h1>
				<p class="summary">{summary}</p>
				<ul aria-label="Technical tags">
					{tags.map((tag: string) => <li>{tag}</li>)}
				</ul>
			</header>
			<article class="project-body">
				<slot />
			</article>
		</div>
	</main>
	<Footer />
</Layout>

<style>
	.project-page {
		padding: clamp(3.5rem, 8vw, 5.75rem) 0 5rem;
	}

	.project-page .container {
		max-width: 820px;
	}

	.back-link {
		color: var(--color-accent);
		display: inline-flex;
		font-size: 0.9rem;
		font-weight: 600;
		margin-bottom: 2.8rem;
		text-decoration: none;
	}

	header {
		border-bottom: 1px solid var(--color-line);
		margin-bottom: 2.25rem;
		padding-bottom: 2.25rem;
	}

	.label {
		color: var(--color-accent);
		font-size: 0.76rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		line-height: 1;
		margin-bottom: 1rem;
		text-transform: uppercase;
	}

	h1 {
		font-size: clamp(2.15rem, 5vw, 3.2rem);
		line-height: 1.12;
		margin-bottom: 1.1rem;
	}

	.summary {
		font-size: 1.08rem;
		margin-bottom: 1.4rem;
	}

	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	li {
		background: var(--color-accent-soft);
		border-radius: 999px;
		color: var(--color-accent-dark);
		font-size: 0.78rem;
		font-weight: 550;
		padding: 0.34rem 0.66rem;
	}

	.project-body {
		background: var(--color-surface);
		border: 1px solid var(--color-line);
		border-radius: var(--radius);
		box-shadow: var(--shadow-soft);
		padding: clamp(1.35rem, 4vw, 2.25rem);
	}

	.project-body :global(h2) {
		font-size: 1.35rem;
		margin-bottom: 0.8rem;
	}

	.project-body :global(p + h2) {
		margin-top: 2rem;
	}

	.project-body :global(p) {
		margin-bottom: 0.7rem;
	}
</style>
