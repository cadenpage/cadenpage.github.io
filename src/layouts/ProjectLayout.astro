---
import Footer from '../components/Footer.astro';
import NavBar from '../components/NavBar.astro';
import Layout from './Layout.astro';

const { frontmatter } = Astro.props;
const { title, summary, tags = [] } = frontmatter;
---

<Layout title={`${title} | Caden Page`} description={summary}>
	<NavBar />
	<main id="main-content">
		<p class="back-link"><a href="/#undergraduate">Back to undergraduate projects</a></p>
		<header>
			<h1>{title}</h1>
			<p>{summary}</p>
			<p class="tags">{tags.join(' · ')}</p>
		</header>
		<article><slot /></article>
	</main>
	<Footer />
</Layout>

<style>
	.back-link { font-size: 0.9rem; margin-bottom: 1.4rem; }
	header { border-bottom: 1px solid var(--color-line); margin-bottom: 1.4rem; padding-bottom: 0.6rem; }
	article :global(figure) { margin: 1.4rem 0; }
	article :global(.project-figure img) { display: block; width: 100%; height: auto; max-height: 620px; object-fit: contain; }
	article :global(.narrow-figure) { max-width: 460px; margin-left: auto; margin-right: auto; }
	article :global(figcaption) { color: var(--color-muted); font-size: 0.82rem; line-height: 1.5; margin-top: 0.45rem; }
	article :global(.project-gallery) { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 1rem; }
	article :global(.project-gallery figure) { margin-top: 0.5rem; }
	@media(max-width:600px) { article :global(.project-gallery) { grid-template-columns: 1fr; } }
	.tags { color: var(--color-muted); font-size: 0.85rem; }
</style>
