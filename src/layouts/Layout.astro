---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Caden Page | Robotics Research and Engineering',
	description = 'Caden Page is a first-year Mechanical Engineering PhD student at UT Austin and NSF Graduate Research Fellow researching robot learning and world models for control in the RobIn (Robot Interactive Intelligence) Lab.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="data:," />
		<meta name="generator" content={Astro.generator} />
		<link rel="preload" href="/fonts/Roboto.ttf" as="font" type="font/ttf" crossorigin />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<slot />
	</body>
</html>

<style is:global>
	@font-face {
		font-family: 'Roboto';
		src: url('/fonts/Roboto.ttf') format('truetype');
		font-style: normal;
		font-weight: 100 900;
		font-display: swap;
	}

	:root {
		--color-bg: #ffffff;
		--color-surface: #ffffff;
		--color-ink: #4a3328;
		--color-muted: #79695d;
		--color-line: #e0d8d0;
		--color-accent: #285b8f;
		--color-accent-dark: #204b76;
		--color-accent-soft: #e8eef5;
		--color-surface-warm: #f7f3ef;
	}

	*, *::before, *::after { box-sizing: border-box; }
	html { background: var(--color-bg); }
	body {
		margin: 2rem auto;
		padding: 0 1.5rem;
		max-width: 1050px;
		display: grid;
		grid-template-columns: 140px minmax(0, 1fr);
		column-gap: 2rem;
		row-gap: 1rem;
		color: var(--color-ink);
		font-family: 'Roboto', 'Segoe UI', Arial, sans-serif;
		font-weight: 300;
		font-size: 16px;
		line-height: 1.6;
		-webkit-font-smoothing: antialiased;
	}
	main { min-width: 0; }
	a { color: var(--color-accent); text-underline-offset: 0.16em; }
	a:hover { color: var(--color-accent-dark); }
	p { margin: 0 0 0.8rem; }
	h1, h2, h3 { font-weight: 300; line-height: 1.3; }
	h1 { font-size: 2rem; margin: 0 0 1rem; }
	h2 {
		font-size: 1.1rem;
		background: var(--color-accent-soft);
		padding: 0.35rem 0.6rem;
		margin: 0 0 0.8rem;
	}
	h3 { font-size: 1rem; margin: 1rem 0 0.4rem; }
	section { padding: 0.8rem 0; scroll-margin-top: 1rem; }
	ul { margin: 0.5rem 0 0.8rem; padding-left: 1.25rem; }
	li { padding-left: 0.15rem; margin-bottom: 0.25rem; }
	img, video { max-width: 100%; height: auto; }
	pre { overflow-x: auto; }
	:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }
	.skip-link { position: absolute; left: -10000px; }
	.skip-link:focus { position: fixed; left: 1rem; top: 0.5rem; padding: 0.5rem; background: white; z-index: 10; }
	@media (max-width: 600px) {
		body { margin: 1rem auto; padding: 0 0.75rem; grid-template-columns: 85px minmax(0, 1fr); column-gap: 1rem; font-size: 15px; }
		h1 { font-size: 1.7rem; }
		h2 { font-size: 1rem; }
	}
</style>

<style is:global>
	table { width: 100%; border-collapse: collapse; margin: 1rem 0; font-size: 0.9rem; }
	th, td { text-align: left; padding: 0.45rem; border-bottom: 1px solid var(--color-line); vertical-align: top; overflow-wrap: anywhere; }
	th { font-weight: 400; }
	@media(max-width:600px) { table { font-size: 0.75rem; } th, td { padding: 0.3rem; } }
</style>
