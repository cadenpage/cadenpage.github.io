---
interface Props {
	eyebrow: string;
	title: string;
	description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<div class="section-heading">
	<p class="eyebrow">{eyebrow}</p>
	<h2>{title}</h2>
	{description && <p class="description">{description}</p>}
</div>

<style>
	.section-heading {
		display: grid;
		gap: 0.8rem;
		margin-bottom: 2.35rem;
		max-width: 720px;
	}

	.eyebrow {
		color: var(--color-ut);
		font-size: 0.76rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		line-height: 1;
		text-transform: uppercase;
	}

	h2 {
		font-size: clamp(1.7rem, 3vw, 2.15rem);
		line-height: 1.18;
	}

	.description {
		font-size: 1rem;
	}
</style>
