---
interface Props {
	title: string;
	summary: string;
	tags: string[];
	href: string;
	githubHref?: string;
	label: string;
}

const { title, summary, href, githubHref } = Astro.props;
---

<article class="project">
	<h3><a href={href}>{title}</a></h3>
	<p>{summary}</p>
	{githubHref && <p><a href={githubHref} target="_blank" rel="noreferrer">Source code</a></p>}
</article>

<style>
	.project { margin: 0 0 1.2rem; }
	.project:last-child { margin-bottom: 0; }
	h3 { font-size: 1rem; margin-bottom: 0.25rem; line-height: 1.5; }
	p { margin: 0; }
</style>
